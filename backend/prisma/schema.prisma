generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  barista
  gm
}

model User {
  id           String @id @default(uuid()) @db.Uuid
  username     String @unique @db.VarChar(64)
  passwordHash String @map("password_hash")
  role         Role

  @@map("users")
}
